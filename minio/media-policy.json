{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::__BUCKET_NAME__"]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::__BUCKET_NAME__/images/*",
        "arn:aws:s3:::__BUCKET_NAME__/videos/*",
        "arn:aws:s3:::__BUCKET_NAME__/audio/*",
        "arn:aws:s3:::__BUCKET_NAME__/documents/*",
        "arn:aws:s3:::__BUCKET_NAME__/subtitles/*"
      ]
    }
  ]
}
