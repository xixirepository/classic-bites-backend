# Non-secret defaults. stack.sh install generates new independent passwords.
FASTAPI_PORT=8000
MYSQL_PORT=3307
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MYSQL_DATABASE=classic_bites
MYSQL_USER=classic_bites
MYSQL_PASSWORD=GENERATE_ON_INSTALL
MYSQL_ROOT_PASSWORD=GENERATE_ON_INSTALL
MINIO_ROOT_USER=classicbitesadmin
MINIO_ROOT_PASSWORD=GENERATE_ON_INSTALL
MINIO_BUCKET=classic-bites-media
MINIO_ACCESS_KEY=classicbitesapi
MINIO_SECRET_KEY=GENERATE_ON_INSTALL
MEDIA_API_KEY=GENERATE_ON_INSTALL
MAX_UPLOAD_BYTES=104857600

# Enable authentication explicitly after preparing HTTPS or a protected local tunnel.
# Google stays unavailable until WEB OAuth client IDs are set.
AUTH_ENABLED=false
AUTH_RATE_LIMIT_SALT=GENERATE_ON_INSTALL
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
GOOGLE_CLIENT_IDS=
